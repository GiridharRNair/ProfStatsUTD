{
    "name": "profstatsutd-extension",
    "displayName": "ProfStats UTD",
    "description": "Chrome extension for professor and course grade insights at UT Dallas.",
    "version": "1.2.0",
    "private": true,
    "engines": {
        "node": ">=20.19.0"
    },
    "manifest": {
        "key": ""
    },
    "scripts": {
        "dev": "plasmo dev --env=../.env",
        "build": "plasmo build --env=../.env",
        "package": "plasmo package --env=../.env",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "plasmo": "^0.90.5",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@types/chrome": "^0.2.9",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "svgo": "^3.3.5",
        "typescript": "^5.8.2"
    }
}
