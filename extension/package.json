{
    "name": "profstatsutd-extension",
    "displayName": "ProfStats UTD",
    "description": "Chrome extension for professor and course grade insights at UT Dallas.",
    "version": "1.2.0",
    "private": true,
    "engines": {
        "node": ">=20.19.0"
    },
    "browserslist": [
        "chrome >= 111"
    ],
    "manifest": {
        "key": "",
        "permissions": [
            "storage"
        ]
    },
    "scripts": {
        "dev": "plasmo dev --env=../.env",
        "build": "plasmo build --env=../.env",
        "package": "plasmo package --env=../.env",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@radix-ui/react-slot": "^1.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "plasmo": "^0.90.5",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^2.6.1"
    },
    "devDependencies": {
        "@types/chrome": "^0.2.9",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "autoprefixer": "^10.5.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.6",
        "svgo": "^3.3.5",
        "tailwindcss": "^3.4.19",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.70.0"
    }
}
